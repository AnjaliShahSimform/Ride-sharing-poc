NODE_ENV=development
PORT=3000

# When running via `npm run dev` on your host machine, connect to the
# dockerized Postgres via localhost. When the app itself runs inside
# docker compose, this becomes postgresql://postgres:postgres@db:5432/...
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ride_sharing?schema=public

# Only used by `prisma migrate`. Same value as DATABASE_URL for a plain local
# Postgres; in production against a pooled connection (e.g. Neon), this must
# be the direct/unpooled connection string instead.
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/ride_sharing?schema=public

FRONTEND_ORIGIN=http://localhost:5173

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

LOG_LEVEL=info

# Global rate limit: max requests per IP per window (default 300 / 15 min).
# Set RATE_LIMIT_ENABLED=false to turn limiting off entirely.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Email notifications (transactional outbox -> RabbitMQ -> Nodemailer).
# Defaults below match docker-compose.yml's rabbitmq + mailpit containers:
#   `docker compose up -d db rabbitmq mailpit`, then read mail at http://localhost:8025
# Set NOTIFICATIONS_ENABLED=false to skip writing/sending emails entirely.
NOTIFICATIONS_ENABLED=true
AMQP_URL=amqp://guest:guest@localhost:5672
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# Real email instead of Mailpit (uncomment one block, fill in your values):
#   Gmail (needs an app password; EMAIL_FROM must be your Gmail address):
#     SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=<you@gmail.com>  SMTP_PASS=<app password>
#   Brevo (free 300/day; EMAIL_FROM must be a verified sender):
#     SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login>  SMTP_PASS=<SMTP key>
EMAIL_FROM="Ride Share <no-reply@ride-sharing.local>"
# true = relay + consumer run inside the web process (needed on Render free).
RUN_WORKER_IN_PROCESS=true

# Rate-limit counters in Redis (shared across instances, survive restarts).
# Leave unset to keep them in process memory. Local: `docker compose up -d redis`.
# Hosted free tiers (Upstash, Redis Cloud) give a rediss:// URL (TLS).
REDIS_URL=redis://localhost:6379
# REDIS_ENABLED=false   # ignore REDIS_URL (the test suite sets this)

# Vehicle verification. Defaults to true; never set false in production.
# REQUIRE_APPROVED_VEHICLE=true

# S3-compatible object storage for vehicle documents (RC / licence).
# Local: `docker compose up -d minio` (console http://localhost:9001, minioadmin/minioadmin).
# Production: any S3-compatible host (e.g. Supabase Storage free tier — no card).
# S3_PUBLIC_ENDPOINT must be the host the BROWSER can reach; inside docker
# S3_ENDPOINT differs from it (http://minio:9000 vs http://localhost:9000).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=vehicle-docs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
