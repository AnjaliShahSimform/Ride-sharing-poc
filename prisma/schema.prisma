generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection — Prisma's advisory
  // locks don't work reliably through a transaction-mode pooler like Neon's
  // pgbouncer endpoint. Locally, both env vars point at the same plain
  // Postgres container, so this is a no-op outside hosted/pooled setups.
  directUrl = env("DIRECT_URL")
}

enum Role {
  DRIVER
  RIDER
  ADMIN
}

enum RideStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum VehicleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocType {
  RC
  LICENCE
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  phone         String
  passwordHash  String
  roles         Role[]
  ridesAsDriver Ride[]
  bookings      Booking[]
  vehicles      Vehicle[]
  createdAt     DateTime @default(now())
}

model Ride {
  id             String     @id @default(uuid())
  driverId       String
  driver         User       @relation(fields: [driverId], references: [id])
  originLat      Float
  originLng      Float
  destLat        Float
  destLng        Float
  originLabel    String
  destLabel      String
  departureTime  DateTime
  totalSeats     Int
  seatsAvailable Int
  estimatedCost  Decimal    @db.Decimal(10, 2)
  status         RideStatus @default(SCHEDULED)
  createdAt      DateTime   @default(now())
  bookings       Booking[]
  vehicle        RideVehicle?

  @@index([departureTime])
  @@index([originLat, originLng])
  @@index([destLat, destLng])
}

model Booking {
  id          String        @id @default(uuid())
  rideId      String
  ride        Ride          @relation(fields: [rideId], references: [id])
  riderId     String
  rider       User          @relation(fields: [riderId], references: [id])
  status      BookingStatus @default(CONFIRMED)
  costShare   Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  cancelledAt DateTime?

  @@index([rideId])
  @@index([riderId])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  actorId    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// Transactional outbox for email notifications. A row is written in the same
// transaction as the change that caused it, so an email is queued if and only
// if that change committed. The notifications relay publishes unpublished
// rows to RabbitMQ; the consumer sends them and stamps `sentAt`.
// One row = one ready-to-send email (already addressed and with its template
// variables snapshotted), so the consumer needs no domain data.
model OutboxEvent {
  id          String    @id @default(uuid())
  template    String
  toEmail     String
  vars        Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  sentAt      DateTime?

  @@index([publishedAt, createdAt])
}

// A driver's vehicle. Rides can only be posted with an APPROVED one (when
// REQUIRE_APPROVED_VEHICLE is on). `plateKey` is the uniqueness handle: it
// equals `plateNumber` while the vehicle is PENDING/APPROVED and is NULL when
// REJECTED (Postgres allows many NULLs under a unique index), so a rejected or
// squatted registration doesn't lock the real owner out of the plate.
model Vehicle {
  id            String        @id @default(uuid())
  ownerId       String
  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  make          String
  model         String
  colour        String
  plateNumber   String
  plateKey      String?       @unique
  seatCapacity  Int
  status        VehicleStatus @default(PENDING)
  rejectionNote String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  documents     VehicleDocument[]
  rideLinks     RideVehicle[]

  @@index([ownerId])
  @@index([status, createdAt])
}

model VehicleDocument {
  id         String   @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type       DocType
  storageKey String
  mimeType   String
  sizeBytes  Int
  uploadedAt DateTime @default(now())

  @@unique([vehicleId, type])
}

// Snapshot of the vehicle a ride was posted with — what riders booked against.
// Deliberately a separate table, NOT columns on Ride: searchRides, getMyRides
// and the admin rides list all call ride.findMany without a `select`, so any
// column added to Ride would be returned to every searcher and stored in the
// Redis search cache. Nothing returns this table unless a query `include`s it.
model RideVehicle {
  rideId    String  @id
  ride      Ride    @relation(fields: [rideId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  make      String
  model     String
  colour    String
  plate     String

  @@index([vehicleId])
}
